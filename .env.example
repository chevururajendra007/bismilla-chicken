# Copy to .env for local dev. NEVER commit .env. Set the same keys in Vercel -> Project -> Settings -> Environment Variables.

# --- Shop ---
SHOP_NAME=Bismilla Chicken
SHOP_PHONE=7904711708
ADMIN_PHONES=7904711708              # comma separated; these numbers become ADMIN on OTP login
UPI_ID=7904711708@ybl                # CONFIRM in owner's PhonePe app -> Profile -> UPI IDs
UPI_PAYEE_NAME=Bismilla Chicken

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
OTP_DEV_MODE=true                    # true = OTP shown on screen (demo). Set false once SMS is configured.
SMS_PROVIDER=                        # msg91 | fast2sms
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=

# --- Storage (Upstash Redis via Vercel Marketplace). Empty = local JSON file ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_PREFIX=bc:

# --- Web push (python scripts/gen_vapid.py) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bismillachicken.in

# --- Local LLM (OpenAI-compatible) ---
LLM_BASE_URL=http://localhost:11434/v1   # Ollama. LM Studio: http://localhost:1234/v1
LLM_MODEL=qwen2.5:7b                     # needs tool-calling: qwen2.5, llama3.1, gemma3 (via ollama), mistral-nemo
LLM_API_KEY=ollama

# --- Maps (optional; OpenStreetMap is used when empty) ---
GOOGLE_MAPS_API_KEY=
